APP_NAME=Ramdev Travels
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Supabase: use the connection string copied from Dashboard > Connect.
# The shared transaction pooler uses port 6543; the API disables asyncpg statement caching for it.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTO_CREATE_TABLES=true
BOOKING_HOLD_MINUTES=15
